
# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_VITALS_TOPIC=iot_vitals
KAFKA_GLUCOSE_TOPIC=iot_glucose

# Azure Data Lake Storage Gen2
AZURE_STORAGE_ACCOUNT=your_storage_account
ADLS_FILESYSTEM=carepulse-data

# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=CarePulseHealthcare
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Application
APP_ENV=development
LOG_LEVEL=INFO
